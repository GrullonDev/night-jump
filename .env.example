# Android release signing. Copy to .env (git-ignored) and fill in real values.
# If .env does not exist, `flutter build appbundle --release` produces an unsigned bundle.
# Passwords are for the KEYSTORE (.jks), not the Play Console login.
# ANDROID_KEYSTORE_PATH accepts ~/..., an absolute path, or a path relative to the project root.
ANDROID_KEYSTORE_PATH=~/keys/night-jump-upload.jks
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=upload
ANDROID_KEY_PASSWORD=
